"""Frontend environment example file."""
# EchoSphere Frontend - Environment Variables
# Copy this to .env.local and fill in your values

# Clerk Auth (get from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Agora RTC (get from https://console.agora.io)
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# Agora Conversational AI Engine
AGORA_CONVOAI_API_KEY=your_agora_convoai_api_key

# Google Gemini API (get from https://ai.google.dev)
GEMINI_API_KEY=your_gemini_api_key

# Supabase PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:password@host:5432/echosphere
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# API Backend URL (for frontend to call)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Email (optional - leave empty for console logging in dev)
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM_DOMAIN=echosphere.app

# JWT Secret (for backend session tokens)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
