# EchoSphere Backend — Environment Variables
# Copy to .env and fill in your values

# ── Database (Supabase PostgreSQL) ──
# Get from Supabase dashboard → Settings → Database
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# ── Supabase ──
SUPABASE_URL=https://[YOUR-PROJECT].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]

# ── Agora RTC ──
# Get from Agora Console → Project Management
AGORA_APP_ID=[YOUR-AGORA-APP-ID]
AGORA_APP_CERTIFICATE=[YOUR-AGORA-APP-CERTIFICATE]

# ── Agora Conversational AI Engine ──
# Get from Agora Console → Conversational AI
AGORA_CONVOAI_API_KEY=[YOUR-AGORA-CONVOAI-API-KEY]

# ── Google Gemini API ──
# Get from Google AI Studio → API Keys
GEMINI_API_KEY=[YOUR-GEMINI-API-KEY]

# ── Anam AI (Real-time Avatar) ──
# Get from Anam Dashboard → API Keys
ANAM_API_KEY=[YOUR-ANAM-API-KEY]
ANAM_AVATAR_ID=[YOUR-ANAM-AVATAR-ID]
ANAM_VOICE_ID=6bfbe25a-979d-40f3-a92b-5394170af54b
ANAM_LLM_ID=ANAM_GPT_4O_MINI_V1

# ── Clerk Auth ──
# Get from Clerk Dashboard → API Keys
CLERK_SECRET_KEY=[YOUR-CLERK-SECRET-KEY]
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=[YOUR-CLERK-PUBLISHABLE-KEY]

# ── JWT (for session tokens when not using Clerk) ──
JWT_SECRET_KEY=[YOUR-SECRET-JWT-KEY-MIN-32-CHARS]

# ── Email (optional — leave empty for console logging in dev) ──
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM_DOMAIN=echosphere.app

# ── Application ──
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false

# ── MCP Whiteboard Server ──
MCP_WHITEBOARD_LISTEN_HOST=127.0.0.1
MCP_WHITEBOARD_LISTEN_PORT=8001
